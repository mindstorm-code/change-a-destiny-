# Copy to .env.local (gitignored) and fill in real values.
# Create the API Key under the Change A Destiny Twilio subaccount:
# console.twilio.com > Account > API keys & tokens > Create API key.
# Do not use the master Auth Token here — the scoped API Key is revocable
# independently and doesn't expose full account control.

TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# The classic Auth Token (not the API Key secret above) — required
# separately to verify inbound Twilio webhook signatures in
# src/app/api/sms/inbound/route.ts. Console > Account > API keys & tokens
# > Auth Token.
TWILIO_AUTH_TOKEN=

# Either set a Messaging Service SID (preferred once one exists) or a
# single sending phone number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Resend (email leg of the reactivation sequence — see resend.com/api-keys).
# RESEND_FROM_EMAIL must be on a domain verified in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Where the lead-capture popup (src/components/LeadCapturePopup.tsx) posts.
# This is MSL Checkout's cross-origin POST /api/leads, hosted on the MSL
# Checkout customer app under Change A Destiny's own tenant hostname — NOT a
# route in this repo. Tenancy there is resolved by the hostname the request
# arrives on, so this must be a hostname aliased to the mslcheckout-customer
# Vercel project specifically (not mslcheckout-client/seller, which is what
# change-a-destiny.mindstormlabs.dev and cadash.mindstormlabs.dev both point
# to — left untouched on purpose). caportal.mindstormlabs.dev was added fresh
# on 2026-09-14 for this and already has an organization_domains row for
# Change A Destiny, but still needs one DNS record at the registrar:
#   A caportal.mindstormlabs.dev 76.76.21.21
# Leave unset to use that hostname as the default once DNS is live.
NEXT_PUBLIC_MSLCHECKOUT_LEADS_URL=
